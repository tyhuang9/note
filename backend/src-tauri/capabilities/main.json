  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Full Note workbench capability. Note persistence remains main-window only.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-load-app-data",
    "allow-save-app-data"
  ]
