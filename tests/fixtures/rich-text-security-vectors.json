{
  "valid": [
    {
      "name": "editor defaults and supported raster image",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Linked",
                "marks": [
                  { "type": "link", "attrs": { "href": "https://example.com/path", "target": null, "rel": null, "class": null, "title": null } },
                  { "type": "textStyle", "attrs": { "fontFamily": null, "fontSize": "16px" } }
                ]
              }
            ]
          },
          { "type": "image", "attrs": { "src": "data:image/png;base64,AA==", "alt": null, "title": null, "width": null, "height": null } }
        ]
      }
    },
    {
      "name": "nested list grammar",
      "doc": { "type": "doc", "content": [{ "type": "bulletList", "content": [{ "type": "listItem", "content": [{ "type": "paragraph" }] }] }] }
    },
    {
      "name": "empty text style attrs and canonical two-byte image",
      "doc": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [{ "type": "text", "text": "Styled", "marks": [{ "type": "textStyle", "attrs": {} }] }] },
          { "type": "image", "attrs": { "src": "data:image/png;base64,AAE=" } }
        ]
      }
    }
  ],
  "invalid": [
    { "name": "javascript link", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "link", "attrs": { "href": "javascript:alert(1)" } }] }] }] } },
    { "name": "link with ascii whitespace", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "link", "attrs": { "href": "https://example.com/a b" } }] }] }] } },
    { "name": "link with unicode whitespace", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "link", "attrs": { "href": "https://example.com/\u00a0x" } }] }] }] } },
    { "name": "link with control character", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "link", "attrs": { "href": "https://example.com/\u0001x" } }] }] }] } },
    { "name": "file image", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "file:///secret.png" } }] } },
    { "name": "remote image", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "https://example.com/tracker.png" } }] } },
    { "name": "svg data image", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "data:image/svg+xml;base64,PHN2Zz4=" } }] } },
    { "name": "malformed base64", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "data:image/png;base64,!" } }] } },
    { "name": "noncanonical one-byte base64 trailing bits", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "data:image/png;base64,AB==" } }] } },
    { "name": "noncanonical two-byte base64 trailing bits", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "data:image/png;base64,AAB=" } }] } },
    { "name": "wrong list child", "doc": { "type": "doc", "content": [{ "type": "bulletList", "content": [{ "type": "paragraph" }] }] } },
    { "name": "unknown node field", "doc": { "type": "doc", "evil": true } },
    { "name": "oversized font", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "textStyle", "attrs": { "fontSize": "120px" } }] }] }] } },
    { "name": "unknown image attr", "doc": { "type": "doc", "content": [{ "type": "image", "attrs": { "src": "https://example.com/a.png", "onerror": "bad" } }] } }
    ,{ "name": "empty doc", "doc": { "type": "doc" } }
    ,{ "name": "empty list", "doc": { "type": "doc", "content": [{ "type": "bulletList" }] } }
    ,{ "name": "list item without paragraph first", "doc": { "type": "doc", "content": [{ "type": "bulletList", "content": [{ "type": "listItem", "content": [{ "type": "blockquote", "content": [{ "type": "paragraph" }] }] }] }] } }
    ,{ "name": "empty text", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "" }] }] } }
    ,{ "name": "duplicate mark", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "bold" }, { "type": "bold" }] }] }] } }
    ,{ "name": "code mark combined", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "code" }, { "type": "bold" }] }] }] } }
    ,{ "name": "marks on non text", "doc": { "type": "doc", "content": [{ "type": "paragraph", "marks": [{ "type": "bold" }] }] } }
    ,{ "name": "text style without attrs", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "textStyle" }] }] }] } }
    ,{ "name": "text style with null attrs", "doc": { "type": "doc", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "x", "marks": [{ "type": "textStyle", "attrs": null }] }] }] } }
  ]
}
